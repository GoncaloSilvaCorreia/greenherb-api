{
  "name": "greenherb-api",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "node src/app.js",
    "test": "jest --coverage",
    "test:report": "jest --coverage --reporters=default --reporters=jest-html-reporter"
  },
  "jest": {
    "testEnvironment": "node",
    "reporters": [
      "default",
      [
        "jest-html-reporter",
        {
          "pageTitle": "GREENHERB - Relatório de Testes",
          "outputPath": "test-report/index.html",
          "includeFailureMsg": true,
          "includeSuiteFailure": true,
          "includeConsoleLog": true,
          "theme": "darkTheme",
          "sort": "titleAsc"
        }
      ]
    ],
    "collectCoverageFrom": [
      "src/**/*.js"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "@babel/code-frame": "^7.29.0",
    "jest": "^30.4.1",
    "jest-html-reporter": "^4.4.0",
    "supertest": "^7.2.2",
    "xlsx": "^0.18.5"
  }
}
